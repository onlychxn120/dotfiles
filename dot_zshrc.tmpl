# zmodload zsh/zprof

# .zshrc - Interactive shell configuration
[[ ! -o interactive ]] && return

source $HOME/.local/share/zsh/aliases.zsh
source $HOME/.local/share/zsh/shell.zsh
source $HOME/.local/share/zsh/init.zsh
{{ if .is_linux }}
source $HOME/.local/share/zsh/functions.zsh
{{ end }}

fpath=(
{{ if .is_mac }}
  /opt/homebrew/share/zsh/site-functions
  /opt/homebrew/share/zsh-completions
{{ end }}
  "$HOME/.local/share/zsh/completions"
  $fpath
)

autoload -Uz compinit
setopt extended_glob

local compdump=${ZDOTDIR:-$HOME}/.zcompdump
local compdump_files=(${ZDOTDIR:-$HOME}/.zcompdump(#qN.mh+24))
local newest_completion=($HOME/.local/share/zsh/completions/*(Nom[1]))

if [[ ${#compdump_files} -gt 0 || ! -f $compdump || ( ${#newest_completion} -gt 0 && $newest_completion[1] -nt $compdump ) ]]; then
  compinit
  touch $compdump
else
  compinit -C
fi

if [[ -s $compdump ]] && (! [[ -s $compdump.zwc ]] || [[ $compdump -nt $compdump.zwc ]]); then
  zcompile $compdump
fi

if command -v fzf &> /dev/null; then
{{ if .is_mac }}
  # Native completion disabled to allow fzf-tab to work
  # [[ -f /opt/homebrew/opt/fzf/shell/completion.zsh ]] && source /opt/homebrew/opt/fzf/shell/completion.zsh
  [[ -f /opt/homebrew/opt/fzf/shell/key-bindings.zsh ]] && source /opt/homebrew/opt/fzf/shell/key-bindings.zsh
{{ else }}
  # Native completion disabled to allow fzf-tab to work
  # [[ -f /usr/share/fzf/completion.zsh ]] && source /usr/share/fzf/completion.zsh
  [[ -f /usr/share/fzf/key-bindings.zsh ]] && source /usr/share/fzf/key-bindings.zsh
{{ end }}
fi

# Defer can remain for non-interactive scripts, but not the UI plugins below
source $HOME/.local/share/zsh/plugins/zsh-defer/zsh-defer.plugin.zsh

# Interactive plugins loaded synchronously in strict order
source $HOME/.local/share/zsh/plugins/fzf-tab/fzf-tab.plugin.zsh
source $HOME/.local/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
source $HOME/.local/share/zsh/plugins/fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh

source $HOME/.local/share/zsh/prompt.zsh

typeset -U PATH path FPATH fpath
# zprof
