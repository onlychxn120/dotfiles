# zmodload zsh/zprof
# p10k instant prompt
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# .zshrc - Interactive shell configuration
[[ ! -o interactive ]] && return

source $HOME/.local/share/zsh/aliases.zsh
source $HOME/.local/share/zsh/shell.zsh
source $HOME/.local/share/zsh/init.zsh

autoload -Uz compinit
setopt extended_glob

local compdump_files=(${ZDOTDIR:-$HOME}/.zcompdump(#qN.mh+24))

if [[ ${#compdump_files} -gt 0 || ! -f ${ZDOTDIR:-$HOME}/.zcompdump ]]; then
  compinit
  touch ${ZDOTDIR:-$HOME}/.zcompdump
else
  compinit -C
fi

if [[ -s ${ZDOTDIR:-$HOME}/.zcompdump ]] && (! [[ -s ${ZDOTDIR:-$HOME}/.zcompdump.zwc ]] || [[ ${ZDOTDIR:-$HOME}/.zcompdump -nt ${ZDOTDIR:-$HOME}/.zcompdump.zwc ]]); then
  zcompile ${ZDOTDIR:-$HOME}/.zcompdump
fi

zstyle ':completion::complete:*' use-cache 1

if command -v fzf &> /dev/null; then
{{ if .is_mac }}
  [[ -f /opt/homebrew/opt/fzf/shell/completion.zsh ]] && source /opt/homebrew/opt/fzf/shell/completion.zsh
  [[ -f /opt/homebrew/opt/fzf/shell/key-bindings.zsh ]] && source /opt/homebrew/opt/fzf/shell/key-bindings.zsh
{{ else }}
  [[ -f /usr/share/fzf/completion.zsh ]] && source /usr/share/fzf/completion.zsh
  [[ -f /usr/share/fzf/key-bindings.zsh ]] && source /usr/share/fzf/key-bindings.zsh
{{ end }}
fi

source $HOME/.local/share/zsh/plugins/fzf-tab/fzf-tab.plugin.zsh
source $HOME/.local/share/zsh/plugins/zsh-defer/zsh-defer.plugin.zsh

zsh-defer source $HOME/.local/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
zsh-defer source $HOME/.local/share/zsh/plugins/fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh

source $HOME/.local/share/zsh/powerlevel10k/powerlevel10k.zsh-theme
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

typeset -U PATH path
# zprof
