# Prevent double-sourcing loop
if [[ -n "$_ENVS_SOURCED" ]]; then return; fi
export _ENVS_SOURCED=1

# Editor used by CLI
export EDITOR="nvim"
export VISUAL="nvim"
export SUDO_EDITOR="$EDITOR"
export BAT_THEME=ansi

# Color man pages with bat
export MANROFFOPT="-c"
export MANPAGER="sh -c 'col -bx | bat -l man -p'"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# External environment setup scripts
if [[ -f "$HOME/.local/bin/env" ]]; then
  source "$HOME/.local/bin/env"
fi

# npm config and cache
export NPM_CONFIG_USERCONFIG="$HOME/.config/npm/npmrc"
export NPM_CONFIG_CACHE="$HOME/.cache/npm"

{{ if .is_mac }}
# brew binaries
export PATH="/opt/homebrew/bin:$PATH"
fpath=(/opt/homebrew/share/zsh/site-functions /opt/homebrew/share/zsh-completions $fpath)
export PATH="$PATH:/Applications/Obsidian.app/Contents/Macos"
export PNPM_HOME="$HOME/Library/pnpm"

{{ else }}
# Always include OMARCHY_PATH - needed for all shell types (scripts, cron, etc.)
export OMARCHY_PATH=$HOME/.local/share/omarchy
export PATH=$OMARCHY_PATH/bin:$PATH:$HOME/.local/bin

#opencode
export PATH=$HOME/.opencode/bin:$PATH

# pnpm
export PNPM_HOME="$HOME/.local/share/pnpm"
{{ end }}
case ":$PATH:" in
*":$PNPM_HOME:"*) ;;
*) export PATH="$PNPM_HOME:$PATH" ;;
esac
