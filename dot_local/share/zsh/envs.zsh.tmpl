# Editor used by CLI
export EDITOR="nvim"
export VISUAL="nvim"
export SUDO_EDITOR="$EDITOR"
export BAT_THEME=ansi

# Color man pages with bat
export MANROFFOPT="-c"
export MANPAGER="sh -c 'col -bx | bat -l man -p'"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# External environment setup scripts
if [[ -f "$HOME/.local/bin/env" ]]; then
  source "$HOME/.local/bin/env"
fi

# npm config and cache
export NPM_CONFIG_USERCONFIG="$HOME/.config/npm/npmrc"
export NPM_CONFIG_CACHE="$HOME/.cache/npm"

{{ if .is_mac }}
# brew binaries
export HOMEBREW_CASK_OPTS="--no-quarantine"
export PATH="/opt/homebrew/bin:$PATH"
export PNPM_HOME="$HOME/Library/pnpm"

{{ else }}

# Omarchy env bootstrap - single source of truth for OMARCHY_PATH and PATH.
# Idempotent; re-sourcing here covers SSH and other non-login zsh sessions.
[ -r "$HOME/.local/share/zsh/env-bootstrap" ] && . "$HOME/.local/share/zsh/env-bootstrap"

# Used by terminal programs (like gh) to open URLs detached from the terminal.
# Shell-scoped on purpose: exporting BROWSER session-wide makes xdg-settings
# refuse to change the default browser.
export BROWSER="${BROWSER:-omarchy-launch-browser}"

# /etc/profile.d/locale.sh only runs for login shells. Zsh started by SSH or
# herdr's remote bridge misses it and lands in the C locale. Mirror it.
if [ -z "${LANG:-}" ]; then
  [ -r /etc/locale.conf ] && . /etc/locale.conf
  LANG="${LANG:-C.UTF-8}"
  export LANG LANGUAGE LC_CTYPE LC_NUMERIC LC_TIME LC_COLLATE LC_MONETARY \
    LC_MESSAGES LC_PAPER LC_NAME LC_ADDRESS LC_TELEPHONE LC_MEASUREMENT \
    LC_IDENTIFICATION
fi

# pnpm
export PNPM_HOME="$HOME/.local/share/pnpm"
{{ end }}
case ":$PATH:" in
*":$PNPM_HOME:"*) ;;
*) export PATH="$PNPM_HOME:$PATH" ;;
esac