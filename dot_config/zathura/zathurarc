# Press 'w' to spawn a second window (GUI & Terminal safe)
map w feedkeys ":exec bash -c \"PATH='/opt/homebrew/bin:/usr/local/bin:/usr/bin:\$PATH' zathura \\\"\$FILE\\\"\"<Return>"

# Google scholar search
map s feedkeys ":exec bash -c \"open 'https://scholar.google.com/scholar?q=$(pbpaste)'\"<Return>"

#'b' to open the table of contents
map b toggle_index

# --- Quality of Life ---
set selection-clipboard clipboard    # Copy text directly to the system clipboard
set adjust-open "best-fit"           # Open PDFs zoomed to perfectly fit the screen
set window-title-basename "true"     # Show only the file name in the title bar, not the full path
set scroll-page-aware "true"         # Stop cleanly at page boundaries when scrolling
set scroll-step 100                   # Make scrolling with j/k a bit faster

# --- Clean UI ---
set guioptions ""                    # Remove the bottom status bar for a totally minimalist view
set statusbar-h-padding 0
set statusbar-v-padding 0

# --- Night Mode (Recolor) ---
set recolor "false"                  # Don't force dark mode on every document launch
set recolor-keephue "true"           # Keep image/math colors intact instead of strictly inverting them
set recolor-darkcolor "#D8DEE9"      # Text color (e.g., a soft white)
set recolor-lightcolor "#2E3440"     # Background color (e.g., a dark slate gray)
map i recolor

# --- Anti-Flash Tweaks ---
set default-bg "#2E3440"
set render-loading-bg "#2E3440"
set render-loading-fg "#D8DEE9"
set render-loading "false"

